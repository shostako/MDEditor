<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive icon の背景レイヤ。単色塗りつぶし (深めのインディゴブルー)。
  Adaptive icon の background は 108x108 viewport を完全に塗る必要がある
  (システムが端末ごとに様々なマスク - 円・squircle 等 - を適用するため、
  端からはみ出ても問題なし、足りないと欠ける)。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:fillColor="#FF4A2EAE"
        android:pathData="M0,0h108v108h-108z" />
</vector>
