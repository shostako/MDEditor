            android:fillColor="#FFFFFFFF"
            android:pathData="M160,-400v-80h280v80H160Zm0,-160v-80h440v80H160Zm0,-160v-80h440v80H160Zm360,560v-123l221,-220q9,-9 20,-13t22,-4q12,0 23,4.5t20,13.5l37,37q8,9 12.5,20t4.5,22q0,11 -4,22.5T863,-380L643,-160H520Zm300,-263l-37,-37 37,37ZM580,-220h38l121,-122 -18,-19 -19,-18 -122,121v38Zm141,-141l-19,-18 37,37 -18,-19Z" />
